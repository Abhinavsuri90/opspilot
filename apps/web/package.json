{
  "name": "opspilot-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:e2e:public": "node scripts/e2e-public.mjs",
    "test:e2e:errors": "node scripts/e2e-errors.mjs",
    "gen-client": "node scripts/gen-client.mjs",
    "test:e2e:workspace": "node scripts/e2e-workspace.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.0",
    "next": "^15.5.0",
    "openapi-fetch": "^0.15.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.26",
    "jsdom": "30.1.1",
    "openapi-typescript": "^7.9.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
