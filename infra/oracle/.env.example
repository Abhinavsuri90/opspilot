# Copy/generate infra/oracle/.env on the VM; never commit it.
# Hostname only: no https://, path, port or trailing slash. DNS must point to the VM.
OPSPILOT_DOMAIN=

# Generate three different random secrets. Use hexadecimal for URL-safe DB passwords.
# Changing these after database initialization does NOT change PostgreSQL passwords.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
JWT_SECRET=

# Private OCI Standard Object Storage bucket in the VM's home region.
# Copy the Amazon S3 compatibility endpoint from Oracle's regional documentation.
S3_ENDPOINT_URL=
S3_REGION=
S3_BUCKET=
# Create an OCI Customer Secret Key, not an API signing key or an auth token.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

MAX_DOCUMENTS_PER_ORG=1000
# Rules parsing has no model API charge. OpenRouter is optional and billed separately.
LLM_PROVIDER=rules
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
